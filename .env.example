# Copy this file to .env and fill in local values.
# Never commit a real .env file.

# API
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/tinyrun
REDIS_URL=redis://localhost:6379

# Public web config only. Do not expose server secrets here.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Per-IP rate limits per 60-second window
RATE_LIMIT_CREATE_MAX=10
RATE_LIMIT_REDIRECT_MAX=60
